{
  "name": "Employee Birthday Reminder",
  "nodes": [
    {
      "parameters": {
        "rule": { "interval": [{ "field": "cronExpression", "expression": "0 8 * * *" }] }
      },
      "name": "Daily at 8AM",
      "type": "n8n-nodes-base.scheduleTrigger",
      "position": [200, 300]
    },
    {
      "parameters": {
        "documentId": { "__rl": true, "value": "YOUR_EMPLOYEES_SHEET_ID", "mode": "id" },
        "sheetName": { "__rl": true, "value": "Employees", "mode": "name" },
        "filtersUI": {
          "values": [
            { "lookupColumn": "BirthdayToday", "lookupValue": "TRUE" }
          ]
        }
      },
      "name": "Find Today Birthdays",
      "type": "n8n-nodes-base.googleSheets",
      "position": [400, 300]
    },
    {
      "parameters": {
        "fromEmail": "hr@YOUR_COMPANY.com",
        "toEmail": "={{ $json.Email }}",
        "subject": "كل عام وأنت بخير يا {{ $json.Name }} 🎂",
        "message": "أعضاء فريقنا يُهنئونك بعيد ميلادك ويتمنون لك عامًا مليئًا بالنجاحات والصحة.",
        "options": {}
      },
      "name": "Send Birthday Email",
      "type": "n8n-nodes-base.gmail",
      "position": [600, 200]
    },
    {
      "parameters": {
        "authentication": "oAuth2",
        "channel": "YOUR_SLACK_CHANNEL_ID",
        "text": "🎂 عيد ميلاد سعيد لـ {{ $json.Name }}! لا تنسَ تقديم التهنئة الشخصية اليوم.",
        "otherOptions": {}
      },
      "name": "Notify Manager on Slack",
      "type": "n8n-nodes-base.slack",
      "position": [600, 400]
    }
  ],
  "connections": {
    "Daily at 8AM": { "main": [[{ "node": "Find Today Birthdays", "type": "main", "index": 0 }]] },
    "Find Today Birthdays": {
      "main": [
        [{ "node": "Send Birthday Email", "type": "main", "index": 0 }],
        [{ "node": "Notify Manager on Slack", "type": "main", "index": 0 }]
      ]
    }
  },
  "settings": { "executionOrder": "v1" }
}
