{
  "name": "تنبيه نفاد المخزون",
  "nodes": [
    {
      "parameters": { "rule": { "interval": [{ "field": "hours", "hoursInterval": 24 }] } },
      "id": "node_schedule",
      "name": "جدول يومي",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1,
      "position": [240, 300]
    },
    {
      "parameters": { "operation": "readRows", "documentId": "YOUR_SHEET_ID", "sheetName": "Inventory" },
      "id": "node_read",
      "name": "قراءة المخزون",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4,
      "position": [480, 300],
      "credentials": { "googleSheetsOAuth2Api": { "id": "YOUR_CREDENTIAL_ID", "name": "Google Sheets" } }
    },
    {
      "parameters": { "conditions": { "number": [{ "value1": "={{ $json.current_qty }}", "operation": "smallerEqual", "value2": "={{ $json.min_threshold }}" }] } },
      "id": "node_filter",
      "name": "فلتر الناقص",
      "type": "n8n-nodes-base.filter",
      "typeVersion": 1,
      "position": [720, 300]
    },
    {
      "parameters": { "sendTo": "YOUR_MANAGER_EMAIL", "subject": "⚠️ تنبيه مخزون: {{ $json.length }} منتج ناقص", "emailType": "html", "message": "<h2>تنبيه نفاد المخزون</h2><p>المنتجات التالية وصلت لحد التنبيه:</p><ul>{{ $json.map(item => `<li>${item.product_name}: ${item.current_qty} (الحد: ${item.min_threshold})</li>`).join('') }}</ul>" },
      "id": "node_email",
      "name": "تقرير التنبيه",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2,
      "position": [960, 300],
      "credentials": { "gmailOAuth2": { "id": "YOUR_CREDENTIAL_ID", "name": "Gmail" } }
    }
  ],
  "connections": {
    "جدول يومي": { "main": [[{ "node": "قراءة المخزون", "type": "main", "index": 0 }]] },
    "قراءة المخزون": { "main": [[{ "node": "فلتر الناقص", "type": "main", "index": 0 }]] },
    "فلتر الناقص": { "main": [[{ "node": "تقرير التنبيه", "type": "main", "index": 0 }]] }
  },
  "settings": { "executionOrder": "v1" }
}
