{
  "name": "Client Invoice Generator",
  "nodes": [
    {
      "parameters": {
        "pollTimes": { "item": [{ "mode": "everyMinute" }] },
        "documentId": { "__rl": true, "value": "YOUR_GOOGLE_FORM_ID", "mode": "id" },
        "sheetName": { "__rl": true, "value": "Sheet1", "mode": "name" }
      },
      "name": "New Form Response",
      "type": "n8n-nodes-base.googleSheetsTrigger",
      "position": [200, 300]
    },
    {
      "parameters": {
        "jsCode": "const data = $input.first().json;\nconst invoiceNumber = `INV-${Date.now()}`;\nconst date = new Date().toLocaleDateString('ar-SA');\nreturn [{ json: { ...data, invoiceNumber, date } }];"
      },
      "name": "Generate Invoice Data",
      "type": "n8n-nodes-base.code",
      "position": [400, 300]
    },
    {
      "parameters": {
        "fromEmail": "YOUR_EMAIL@gmail.com",
        "toEmail": "={{ $json.clientEmail }}",
        "subject": "فاتورة رقم {{ $json.invoiceNumber }} — {{ $json.serviceName }}",
        "emailType": "html",
        "message": "<h2>فاتورة خدمة</h2><p>العميل: {{ $json.clientName }}</p><p>الخدمة: {{ $json.serviceName }}</p><p>المبلغ: {{ $json.amount }} ريال</p><p>رقم الفاتورة: {{ $json.invoiceNumber }}</p>",
        "options": {}
      },
      "name": "Send Invoice Email",
      "type": "n8n-nodes-base.gmail",
      "position": [600, 300]
    }
  ],
  "connections": {
    "New Form Response": { "main": [[{ "node": "Generate Invoice Data", "type": "main", "index": 0 }]] },
    "Generate Invoice Data": { "main": [[{ "node": "Send Invoice Email", "type": "main", "index": 0 }]] }
  },
  "settings": { "executionOrder": "v1" }
}
