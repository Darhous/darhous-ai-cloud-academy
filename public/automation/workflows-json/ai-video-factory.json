    {
      "parameters": {
        "method": "GET",
        "url": "https://api.pexels.com/videos/search",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Authorization", "value": "={{ $env.PEXELS_API_KEY }}" }
          ]
        },
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            { "name": "query", "value": "={{ $('تحليل رد Gemini').first().json.search_keywords || 'education learning technology' }}" },
            { "name": "per_page", "value": "5" },
            { "name": "orientation", "value": "portrait" }
          ]
        }
      },
      "id": "node_pexels",
      "name": "بحث فيديوهات Pexels",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [2000, 300]
    },
    {
      "parameters": {
        "jsCode": "const pexels = $input.first().json;\nconst scriptData = $('تحليل رد Gemini').first().json;\nconst videos = (pexels.videos || []).slice(0, 3);\n\nconst clips = videos.map((v, i) => {\n  const sdFile = v.video_files.find(f => f.quality === 'sd' || f.height <= 720) || v.video_files[0];\n  return {\n    asset: { type: 'video', src: sdFile.link, trim: 0 },\n    start: i * 5,\n    length: 5,\n    effect: i === 0 ? 'zoomIn' : 'slideLeft'\n  };\n});\n\nconst title = (scriptData.title || '').replace(/[<>\"]/g, '');\nconst hashtags = (scriptData.hashtags || []).slice(0, 3).join(' ');\n\nconst titleOverlay = {\n  asset: {\n    type: 'html',\n    html: `<div style=\"font-family:Arial;color:white;font-size:32px;text-align:center;direction:rtl;background:rgba(0,0,0,0.6);padding:16px;border-radius:8px\">${title}</div>`,\n    width: 720,\n    height: 160\n  },\n  start: 0,\n  length: 4,\n  position: 'bottom',\n  offset: { y: -0.15 }\n};\n\nconst hashtagOverlay = {\n  asset: {\n    type: 'html',\n    html: `<div style=\"font-family:Arial;color:#FFD700;font-size:20px;direction:rtl\">${hashtags}</div>`,\n    width: 720,\n    height: 80\n  },\n  start: 11,\n  length: 4,\n  position: 'bottom'\n};\n\nreturn [{\n  json: {\n    timeline: {\n      background: '#000000',\n      tracks: [\n        { clips },\n        { clips: [titleOverlay, hashtagOverlay] }\n      ]\n    },\n    output: { format: 'mp4', resolution: 'sd', aspectRatio: '9:16', fps: 25 },\n    job_id: scriptData.job_id,\n    title: scriptData.title\n  }\n}];"
      },
