        }
      },
      "id": "node_set_init",
      "name": "تهيئة الوظيفة",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3,
      "position": [460, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.SUPABASE_URL }}/rest/v1/ai_video_jobs",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "apikey", "value": "={{ $env.SUPABASE_ANON_KEY }}" },
            { "name": "Authorization", "value": "=Bearer {{ $env.SUPABASE_ANON_KEY }}" },
            { "name": "Content-Type", "value": "application/json" },
            { "name": "Prefer", "value": "return=representation" }
          ]
        },
        "sendBody": true,
        "bodyContentType": "json",
        "jsonBody": "={ \"topic\": \"{{ $json.topic }}\", \"language\": \"{{ $json.language }}\", \"status\": \"pending\", \"platform\": \"{{ $json.platform }}\", \"created_at\": \"{{ $now.toISO() }}\" }"
      },
      "id": "node_supabase_insert",
      "name": "إنشاء وظيفة",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [680, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://generativelanguage.googleapis.com/v1beta/models/gemini-1.5-flash:generateContent?key={{ $env.GEMINI_API_KEY }}",
        "sendBody": true,
        "bodyContentType": "json",
        "jsonBody": "={ \"contents\": [{ \"parts\": [{ \"text\": \"أنت خبير محتوى تعليمي عربي. اكتب سكريبت فيديو تعليمي (60 ثانية) بالعربية الفصحى عن: {{ $('تهيئة الوظيفة').first().json.topic }}. أعد الرد بصيغة JSON فقط بدون أي نص إضافي: {\\\"title\\\": \\\"عنوان جذاب\\\", \\\"script\\\": \\\"نص السكريبت الكامل هنا\\\", \\\"hashtags\\\": [\\\"#هاشتاق1\\\", \\\"#هاشتاق2\\\", \\\"#هاشتاق3\\\", \\\"#هاشتاق4\\\", \\\"#هاشتاق5\\\"], \\\"search_keywords\\\": \\\"english keywords for stock video search\\\"}\" }] }] }"
      },
      "id": "node_gemini",
      "name": "توليد السكريبت",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [900, 300]
    },
    {
      "parameters": {
        "jsCode": "const raw = $input.first().json.candidates[0].content.parts[0].text;\nlet parsed;\ntry {\n  const match = raw.match(/\\{[\\s\\S]*\\}/);\n  parsed = JSON.parse(match[0]);\n} catch(e) {\n  parsed = {\n    title: 'فيديو تعليمي',\n    script: raw.replace(/```json|```/g, '').trim().substring(0, 600),\n    hashtags: ['#تعلم', '#AI', '#تعليم', '#عربي', '#مهارات'],\n    search_keywords: 'education technology learning'\n  };\n}\nconst jobData = $('إنشاء وظيفة').first().json;\nreturn [{\n  json: {\n    ...parsed,\n    job_id: Array.isArray(jobData) ? jobData[0].id : jobData.id,\n    topic: $('تهيئة الوظيفة').first().json.topic\n  }\n}];"
      },
      "id": "node_parse_gemini",
      "name": "تحليل رد Gemini",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1120, 300]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": false, "typeValidation": "strict" },
          "conditions": [
            {
              "id": "len-check",
              "leftValue": "={{ $json.script.length }}",
              "rightValue": 100,
              "operator": { "type": "number", "operation": "gte" }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "node_if_quality",
      "name": "فحص جودة السكريبت",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [1340, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.elevenlabs.io/v1/text-to-speech/21m00Tcm4TlvDq8ikWAM",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "xi-api-key", "value": "={{ $env.ELEVENLABS_API_KEY }}" },
            { "name": "Content-Type", "value": "application/json" },
            { "name": "Accept", "value": "audio/mpeg" }
          ]
        },
        "sendBody": true,
        "bodyContentType": "json",
        "jsonBody": "={ \"text\": \"{{ $json.script.substring(0, 500) }}\", \"model_id\": \"eleven_multilingual_v2\", \"voice_settings\": { \"stability\": 0.5, \"similarity_boost\": 0.75 } }",
        "responseFormat": "file"
      },
      "id": "node_elevenlabs",
