# Darhous AI Cloud Academy — Environment Variables
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to version control.

# ─── AI Mentor (required for /mentor to function) ────────────────────────────
# Get your key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini model to use (optional — defaults to gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# ─── Supabase (required for auth, dashboard, and admin features) ──────────────
# Get these from: https://app.supabase.com → Project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_server_only

# ─── Site URL (used for OAuth redirect) ──────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://darhous-ai-cloud-academy.vercel.app

# ─── Contact Email Notifications (optional) ──────────────────────────────────
# Install resend: npm install resend
# Get your key at: https://resend.com/api-keys
# If not set, contact messages are saved to Supabase only (no email sent).
RESEND_API_KEY=optional_resend_key_here
CONTACT_TO_EMAIL=ahmeddarhous@gmail.com

# ─── Re-engagement Cron (required for /api/email/reengagement) ───────────────
# A strong random secret shared between your cron job and this API route.
# Generate with: openssl rand -hex 32
# Call the route with header: x-cron-secret: <value>
REENGAGEMENT_CRON_SECRET=your_reengagement_cron_secret_here

# ─── Notes ───────────────────────────────────────────────────────────────────
# SUPABASE_SERVICE_ROLE_KEY is SERVER-ONLY. Never prefix with NEXT_PUBLIC_.
# The app builds and runs without Supabase — auth features show setup states.
# See SUPABASE_SETUP.md for full setup instructions.
# REENGAGEMENT_CRON_SECRET is SERVER-ONLY. Never prefix with NEXT_PUBLIC_.
